{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash(*)", "Write", "Edit"],
    "deny": [
      "Bash(sf org delete *)",
      "Bash(sf project delete *)",
      "Bash(sf data delete *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/skills/apex-callouts-developer/scripts/guard.mjs",
            "statusMessage": "apex-callouts-developer: checando acao destrutiva/artefato compartilhado"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "path=$(cat | jq -r '.tool_input.file_path // .tool_input.path // \"\"'); case \"$path\" in *.claude/skills/apex-callouts-developer/scripts/*) node --test .claude/skills/apex-callouts-developer/tests/*.test.mjs ;; esac",
            "statusMessage": "apex-callouts-developer: rodando testes apos edicao em scripts/"
          }
        ]
      }
    ]
  }
}
