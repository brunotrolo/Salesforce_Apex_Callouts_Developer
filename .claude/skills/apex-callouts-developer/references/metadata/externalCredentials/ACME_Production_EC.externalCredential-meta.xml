<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- EC de TOKEN para PRD: mesmo padrao do HML.
         Substituir o parameterValue pelo Basic da PRD antes do deploy em producao:
         base64(clientId_prd:clientSecret_prd) -->
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>ACME_Principal</parameterGroup>
        <parameterName>ACME_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>Basic SEU_BASE64_PRD</parameterValue>
        <sequenceNumber>2</sequenceNumber>
    </externalCredentialParameters>
    <label>ACME Producao Token</label>
</ExternalCredential>
