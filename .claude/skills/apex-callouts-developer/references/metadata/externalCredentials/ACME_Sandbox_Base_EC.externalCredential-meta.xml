<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- EC BASE para HML: sem autenticacao propria.
         O Named Credential ACME_Sandbox usa este EC apenas para
         agrupar o principal. O Bearer token e injetado pelo Apex
         via getAccessToken() antes de cada callout. -->
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>ACME_Principal</parameterGroup>
        <parameterName>ACME_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>ACME Homologacao Base</label>
</ExternalCredential>
